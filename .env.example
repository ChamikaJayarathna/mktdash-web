# ---------------------------------------------------------------------------
# End-to-end tests (Playwright)
# ---------------------------------------------------------------------------

PLAYWRIGHT_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Externally managed — do not set these in a local .env file
# ---------------------------------------------------------------------------

# CI — read in playwright.config.ts to enable retries, the `github` reporter,
# `forbidOnly`, and a production build instead of the dev server. Set by the CI
# provider (GitHub Actions sets CI=true automatically).
# CI=true

# NODE_ENV — read in src/app/providers/QueryProvider.tsx to mount the TanStack
# Query devtools. Set by Next.js per command (`next dev` = development,
# `next build`/`next start` = production). Next.js warns against overriding it.
# NODE_ENV=development
